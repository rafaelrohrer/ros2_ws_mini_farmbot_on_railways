<?xml version="1.0"?>
<robot name="mini_farmbot_endeffektor" xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:macro name="mini_farmbot_endeffektor" params="parent">
		<xacro:property name="gripper_body_size" value="0.04"/>
		<xacro:property name="finger_length" value="0.03"/>
		<xacro:property name="finger_width" value="0.01"/>
		<xacro:property name="finger_thickness" value="0.01"/>
		<xacro:property name="finger_side_offset" value="0.025"/>

		<link name="gripper_body">
			<visual>
				<origin xyz="0 0 0" rpy="0 0 0"/>
				<geometry>
					<box size="${gripper_body_size} ${gripper_body_size} ${gripper_body_size}"/>
				</geometry>
				<material name="turquoise"/>
			</visual>
			<collision>
				<origin xyz="0 0 0" rpy="0 0 0"/>
				<geometry>
					<box size="${gripper_body_size} ${gripper_body_size} ${gripper_body_size}"/>
				</geometry>
			</collision>
			<inertial>
				<origin xyz="0 0 0" rpy="0 0 0"/>
				<mass value="0.20"/>
				<inertia
					ixx="1.2e-4"
					ixy="0.0"
					ixz="0.0"
					iyy="1.2e-4"
					iyz="0.0"
					izz="1.2e-4"/>
			</inertial>
		</link>

		<link name="gripper_left_finger">
			<visual>
				<origin xyz="0 0 0" rpy="0 0 0"/>
				<geometry>
					<box size="${finger_width} ${finger_thickness} ${finger_length}"/>
				</geometry>
				<material name="aluminum"/>
			</visual>
			<collision>
				<origin xyz="0 0 0" rpy="0 0 0"/>
				<geometry>
					<box size="${finger_width} ${finger_thickness} ${finger_length}"/>
				</geometry>
			</collision>
			<inertial>
				<origin xyz="0 0 0" rpy="0 0 0"/>
				<mass value="0.01"/>
				<inertia
					ixx="1.0e-5"
					ixy="0.0"
					ixz="0.0"
					iyy="1.0e-5"
					iyz="0.0"
					izz="1.0e-5"/>
			</inertial>
		</link>

		<link name="gripper_right_finger">
			<visual>
				<origin xyz="0 0 0" rpy="0 0 0"/>
				<geometry>
					<box size="${finger_width} ${finger_thickness} ${finger_length}"/>
				</geometry>
				<material name="aluminum"/>
			</visual>
			<collision>
				<origin xyz="0 0 0" rpy="0 0 0"/>
				<geometry>
					<box size="${finger_width} ${finger_thickness} ${finger_length}"/>
				</geometry>
			</collision>
			<inertial>
				<origin xyz="0 0 0" rpy="0 0 0"/>
				<mass value="0.01"/>
				<inertia
					ixx="1.0e-5"
					ixy="0.0"
					ixz="0.0"
					iyy="1.0e-5"
					iyz="0.0"
					izz="1.0e-5"/>
			</inertial>
		</link>

		<joint name="${parent}_to_gripper_body" type="fixed">
			<parent link="${parent}"/>
			<child link="gripper_body"/>
			<origin xyz="0 0 ${-(profile_length / 2.0 + gripper_body_size / 2.0)}" rpy="0 0 0"/>
		</joint>

		<joint name="gripper_body_to_left_finger" type="fixed">
			<parent link="gripper_body"/>
			<child link="gripper_left_finger"/>
			<origin xyz="0 ${finger_side_offset} ${-(gripper_body_size / 2.0 + finger_length / 2.0)}" rpy="0 0 0"/>
		</joint>

		<joint name="gripper_body_to_right_finger" type="fixed">
			<parent link="gripper_body"/>
			<child link="gripper_right_finger"/>
			<origin xyz="0 ${-finger_side_offset} ${-(gripper_body_size / 2.0 + finger_length / 2.0)}" rpy="0 0 0"/>
		</joint>
	</xacro:macro>

</robot>
