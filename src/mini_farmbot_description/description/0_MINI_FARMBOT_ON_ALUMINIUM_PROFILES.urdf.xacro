<?xml version="1.0"?>
<robot name="mini_farmbot_on_aluminium_profiles" xmlns:xacro="http://www.ros.org/wiki/xacro">
	<xacro:arg name="sim_mode" default="false"/>
	<xacro:arg name="use_ros2_control" default="true"/>

	<material name="aluminum">
		<color rgba="0.75 0.75 0.78 1.0"/>
	</material>
	<material name="turquoise">
		<color rgba="0.25 0.88 0.82 1.0"/>
	</material>

	<xacro:include filename="mini_farmbot_Aluprofil_grundgerüst.urdf.xacro"/>
	<xacro:include filename="mini_farmbot_endeffektor.urdf.xacro"/>
	<xacro:include filename="mini_farmbot_Schienen.urdf.xacro"/>
	<xacro:include filename="ros2_control.xacro"/>

	<link name="base_link"/>

	<xacro:aluprofil_grundgeruest parent="base_link" mobile_x="true" x_lower="-1.0" x_upper="1.0"/>
	<xacro:mini_farmbot_endeffektor parent="z_axis"/>
	<xacro:schienen_pair parent="base_link"/>

</robot>
