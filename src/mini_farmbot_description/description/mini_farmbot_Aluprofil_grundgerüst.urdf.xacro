<?xml version="1.0"?>
<robot name="mini_farmbot_aluprofil_grundgeruest" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Eigenschaften der Aluprofile und zusätzlichen Teile (Masse, Länge, Breite, Höhe) werden hier definiert. -->
    <xacro:property name="profile_size" value="0.02"/>
    <xacro:property name="profile_length" value="0.50"/>
    <xacro:property name="half_span" value="${profile_length / 2.0}"/>
    <xacro:property name="profile_mass" value="1.0"/>
    <xacro:property name="connector_size" value="0.1"/>
    <!-- Blaupause für das Einsetzen der verschiedenen Parameter (räumliche Position, Masse, geometrische Gegebenheiten) der Aluprofile -->
    <xacro:macro name="Alu_profil" params="name sx sy sz ox oy oz">
        <link name="${name}">
            <visual>
                <origin xyz="${ox} ${oy} ${oz}" rpy="0 0 0"/>
                <geometry>
                    <box size="${sx} ${sy} ${sz}"/>
                </geometry>
                <material name="aluminum"/>
            </visual>
            <collision>
                <origin xyz="${ox} ${oy} ${oz}" rpy="0 0 0"/>
                <geometry>
                    <box size="${sx} ${sy} ${sz}"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="${ox} ${oy} ${oz}" rpy="0 0 0"/>
                <mass value="${profile_mass}"/>
                <inertia
                    ixx="${(1.0 / 12.0) * profile_mass * (sy * sy + sz * sz)}"
                    ixy="0.0"
                    ixz="0.0"
                    iyy="${(1.0 / 12.0) * profile_mass * (sx * sx + sz * sz)}"
                    iyz="0.0"
                    izz="${(1.0 / 12.0) * profile_mass * (sx * sx + sy * sy)}"/>
            </inertial>
        </link>
    </xacro:macro>

    <!-- Initialisierung der verschiedenen Aluprofile.
         Beim Erstellen eines Aluprofils wird per default die Position dessen Mittelpunktes auf den Koordinatenmittelpunkt (x=0, y=0, z=0) gesetzt. 
         die Masse (sx, sy, sz) werden entsprechend der Auslegung der Aluprofile (horizontal/vertikal) ausgelegt.
         Die Joints zwischen den Aluprofilen und dem base_link bestimmen die Positionen der Aluprofile.
         Algemein wird der Ursprung des Parent link genutzt für die Positionsbestimmung des Ursprungs des Child links. 
         Jene relative Positionsbestimmung wird im Joint-tag definiert -->
    <xacro:macro name="aluprofil_grundgeruest" params="parent mobile_x:=false x_lower:=-1.0 x_upper:=1.0 x_effort:=30.0 x_velocity:=0.2">
        <xacro:Alu_profil name="leg_front_left"
                           sx="${profile_size}" sy="${profile_size}" sz="${profile_length}"
                           ox="0.0" oy="0.0" oz="0.0"/>
        <xacro:Alu_profil name="leg_front_right"
                           sx="${profile_size}" sy="${profile_size}" sz="${profile_length}"
                           ox="0.0" oy="0.0" oz="0.0"/>
        <xacro:Alu_profil name="leg_back_left"
                           sx="${profile_size}" sy="${profile_size}" sz="${profile_length}"
                           ox="0.0" oy="0.0" oz="0.0"/>
        <xacro:Alu_profil name="leg_back_right"
                           sx="${profile_size}" sy="${profile_size}" sz="${profile_length}"
                           ox="0.0" oy="0.0" oz="0.0"/>

        <xacro:Alu_profil name="top_front"
                           sx="${profile_length}" sy="${profile_size}" sz="${profile_size}"
                           ox="${half_span}" oy="0.0" oz="0.0"/>
        <xacro:Alu_profil name="top_back"
                           sx="${profile_length}" sy="${profile_size}" sz="${profile_size}"
                           ox="${half_span}" oy="0.0" oz="0.0"/>
        <xacro:Alu_profil name="top_left"
                           sx="${profile_size}" sy="${profile_length}" sz="${profile_size}"
                           ox="0.0" oy="${half_span}" oz="0.0"/>
        <xacro:Alu_profil name="top_right"
                           sx="${profile_size}" sy="${profile_length}" sz="${profile_size}"
                           ox="0.0" oy="${half_span}" oz="0.0"/>

        <xacro:Alu_profil name="y_axis"
                           sx="${profile_size}" sy="${profile_length}" sz="${profile_size}"
                           ox="0.0" oy="0.0" oz="0.0"/>

        <xacro:Alu_profil name="y_to_z_connector"
                   sx="${profile_size / 2.0}" sy="${connector_size}" sz="${connector_size}"
                   ox="0.0" oy="0.0" oz="0.0"/>

        <xacro:Alu_profil name="z_axis"
                           sx="${profile_size}" sy="${profile_size}" sz="${profile_length}"
                           ox="0.0" oy="0.0" oz="0.0"/>

        
            <joint name="${parent}_to_leg_front_left" type="prismatic">
                <parent link="${parent}"/>
                <child link="leg_front_left"/>
                <origin xyz="${half_span} ${half_span} ${profile_length / 2.0}" rpy="0 0 0"/>
                <axis xyz="1 0 0"/>
                <limit lower="${x_lower}" upper="${x_upper}" effort="${x_effort}" velocity="${x_velocity}"/>
            </joint>

            <joint name="${parent}_to_leg_front_right" type="fixed">
                <parent link="leg_front_left"/>
                <child link="leg_front_right"/>
                <origin xyz="0 ${-profile_length} 0" rpy="0 0 0"/>
                <axis xyz="1 0 0"/>
                <limit lower="${x_lower}" upper="${x_upper}" effort="${x_effort}" velocity="${x_velocity}"/>
            </joint>

            <joint name="leg_front_left_to_leg_back_left" type="fixed">
                <parent link="leg_front_left"/>
                <child link="leg_back_left"/>
                <origin xyz="${-profile_length} 0 0" rpy="0 0 0"/>
            </joint>

            <joint name="leg_front_left_to_leg_back_right" type="fixed">
                <parent link="leg_front_left"/>
                <child link="leg_back_right"/>
                <origin xyz="${-profile_length} ${-profile_length} 0" rpy="0 0 0"/>
            </joint>

            <joint name="leg_front_left_to_top_front" type="fixed">
                <parent link="leg_front_left"/>
                <child link="top_front"/>
                <origin xyz="${-profile_length} ${-profile_length} ${profile_length / 2.0}" rpy="0 0 0"/>
            </joint>

            <joint name="leg_front_left_to_top_back" type="fixed">
                <parent link="leg_front_left"/>
                <child link="top_back"/>
                <origin xyz="${-profile_length} 0 ${profile_length / 2.0}" rpy="0 0 0"/>
            </joint>

            <joint name="leg_front_left_to_top_left" type="fixed">
                <parent link="leg_front_left"/>
                <child link="top_left"/>
                <origin xyz="${-profile_length} ${-profile_length} ${profile_length / 2.0}" rpy="0 0 0"/>
            </joint>

            <joint name="leg_front_left_to_top_right" type="fixed">
                <parent link="leg_front_left"/>
                <child link="top_right"/>
                <origin xyz="0 ${-profile_length} ${profile_length / 2.0}" rpy="0 0 0"/>
            </joint>

            <joint name="leg_front_left_to_y_axis" type="fixed">
                <parent link="leg_front_left"/>
                <child link="y_axis"/>
                <origin xyz="${-half_span} ${-half_span} ${profile_length / 2.0}" rpy="0 0 0"/>
            </joint>

        <!-- Joint zwischen y_axis und y_to_z_connector -->
        <joint name="y_axis_to_y_to_z_connector" type="prismatic">
            <parent link="y_axis"/>
            <child link="y_to_z_connector"/>
            <origin xyz="${(profile_size / 2.0)+(profile_size / 4.0)} 0 0" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
            <limit lower="${-(profile_length / 2.0) + (profile_size / 4.0)}"
                   upper="${(profile_length / 2.0) - (profile_size / 4.0)}"
                   effort="10.0"
                   velocity="0.1"/>
        </joint>

        <!-- Joint zwischen y_to_z_connector und z_axis -->
        <joint name="y_to_z_connector_to_z_axis" type="prismatic">
            <parent link="y_to_z_connector"/>
            <child link="z_axis"/>
            <origin xyz="${(profile_size / 2.0)+(profile_size / 4.0)} 0 0" rpy="0 0 0"/>
            <axis xyz="0 0 1"/>
            <limit lower="${-(profile_length / 2.0) + (profile_size / 4.0)}"
                   upper="${(profile_length / 2.0) - (profile_size / 4.0)}"
                   effort="10.0"
                   velocity="0.1"/>
        </joint>

    </xacro:macro>

</robot>
