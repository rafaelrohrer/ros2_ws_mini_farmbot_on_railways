<?xml version="1.0"?>
<robot name="mini_farmbot_schienen" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="rail_length" value="2.0"/>
    <xacro:property name="rail_width" value="0.02"/>
    <xacro:property name="rail_height" value="0.02"/>
    <xacro:property name="rail_mass" value="1.0"/>
    <xacro:property name="half_span" value="${profile_length / 2.0}"/>

    <xacro:macro name="schiene" params="name parent ox oy oz">
        <link name="${name}">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="${rail_length} ${rail_width} ${rail_height}"/>
                </geometry>
                <material name="aluminum"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="${rail_length} ${rail_width} ${rail_height}"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="${rail_mass}"/>
                <inertia ixx="${(1.0/12.0)*rail_mass*(rail_width*rail_width + rail_height*rail_height)}"
                         ixy="0.0"
                         ixz="0.0"
                         iyy="${(1.0/12.0)*rail_mass*(rail_length*rail_length + rail_height*rail_height)}"
                         iyz="0.0"
                         izz="${(1.0/12.0)*rail_mass*(rail_length*rail_length + rail_width*rail_width)}"/>
            </inertial>
        </link>

        <joint name="${name}_joint" type="fixed">
            <parent link="${parent}"/>
            <child link="${name}"/>
            <origin xyz="${ox} ${oy} ${oz}" rpy="0 0 0"/>
        </joint>
    </xacro:macro>

    <xacro:macro name="schienen_pair" params="parent">
        <xacro:schiene name="rail_left" parent="${parent}" ox="0.0" oy="${half_span}" oz="0.0"/>
        <xacro:schiene name="rail_right" parent="${parent}" ox="0.0" oy="-${half_span}" oz="0.0"/>
    </xacro:macro>

</robot>
