<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="ros2_joint_control" params="name">
        <joint name="${name}">
            <command_interface name="position"/>
            <state_interface name="position"/>
        </joint>
    </xacro:macro>

    <xacro:macro name="farmbot_ros2_control"
                 params="joint_x joint_y joint_z controller_config sim_mode:=false use_ros2_control:=true use_arduino_hardware:=false">
        <xacro:if value="${use_ros2_control}">
            <ros2_control name="MiniFarmbotJointTrajectory1" type="system">
                <hardware>
                    <xacro:if value="${sim_mode}">
                        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                    </xacro:if>
                    <xacro:if value="${use_arduino_hardware}">
                        <plugin>mini_farmbot_hardware/MiniFarmbotSystem</plugin>
                        <param name="device">/dev/ttyACM0</param>
                        <param name="baud_rate">115200</param>
                        <param name="x_steps_per_meter">60000.0</param>
                        <param name="y_steps_per_meter">60000.0</param>
                        <param name="z_steps_per_meter">80000.0</param>
                        <param name="max_speed_steps_per_second">1000.0</param>
                    </xacro:if>
                    <xacro:unless value="${sim_mode}">
                        <xacro:unless value="${use_arduino_hardware}">
                            <plugin>mock_components/GenericSystem</plugin>
                        </xacro:unless>
                    </xacro:unless>
                </hardware>

                <xacro:ros2_joint_control name="${joint_x}"/>
                <xacro:ros2_joint_control name="${joint_y}"/>
                <xacro:ros2_joint_control name="${joint_z}"/>
            </ros2_control>

            <xacro:if value="${sim_mode}">
                <gazebo>
                    <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="/opt/ros/humble/lib/libign_ros2_control-system.so">
                        <parameters>$(find mini_farmbot_description)/config/${controller_config}</parameters>
                    </plugin>
                </gazebo>
            </xacro:if>
        </xacro:if>
    </xacro:macro>
</robot>
