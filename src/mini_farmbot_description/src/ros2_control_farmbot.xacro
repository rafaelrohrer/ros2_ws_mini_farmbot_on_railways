<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="ros2_joint_control" params="parent child">
        <joint name="${parent}_to_${child}">
            <command_interface name="position"/>
            <state_interface name="position"/>
        </joint>
    </xacro:macro>

    <xacro:if value="$(arg use_ros2_control)">
        <ros2_control name="MiniFarmbotJointTrajectory1" type="system">
            <hardware>
                <xacro:if value="$(arg sim_mode)">
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </xacro:if>
                <xacro:unless value="$(arg sim_mode)">
                    <plugin>mock_components/GenericSystem</plugin>
                </xacro:unless>
            </hardware>

            <xacro:ros2_joint_control parent="rail_left" child="vertical_leg_left"/>
            <xacro:ros2_joint_control parent="y_axis" child="y_to_z_connector"/>
            <xacro:ros2_joint_control parent="y_to_z_connector" child="z_axis"/>
        </ros2_control>

        <gazebo>
            <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="/opt/ros/humble/lib/libign_ros2_control-system.so">
                <parameters>$(find mini_farmbot_description)/config/farmbot_controllers.yaml</parameters>
            </plugin>
        </gazebo>
    </xacro:if>
</robot>
